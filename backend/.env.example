# Copy this file to .env (which git ignores) and adjust if needed.
PORT=3000
DATABASE_URL=postgres://food:food@localhost:5432/food

# Secret used to sign login tokens. Use a long random value, e.g. from: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
# bcrypt cost factor (each +1 doubles hashing time). Optional, default 12.
# BCRYPT_ROUNDS=12
